# Database
DATABASE_URL=postgresql://cb_user:cb_pass@localhost:5432/creditbridge

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256 Encryption Key (32 bytes base64 encoded)
ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key-here

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Data paths
MOCK_DATA_PATH=/data/mock
